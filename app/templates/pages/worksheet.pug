            summary.is-flex
                +key-val('2026-08-20', '08:00', {'class': 'is-flex-grow-1'})
            .fixed-grid.has-4-cols
                .grid
                    .cell(style={'white-space': 'nowrap'}) 08:00 - 12:00
                    .cell(style={'white-space': 'nowrap'}) 13:00 - 17:00
