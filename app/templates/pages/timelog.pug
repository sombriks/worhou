extends ../layouts/main
include ../components/shared/message

block head
    title Timelog
block content
    .timelog-content
        +message("Today's timelog", "is-info is-hidden", true)
            p(hx-trigger="load",
                hx-swap="outerHTML",
                hx-target="closest .message"
                hx-get=`${base}/timelog/today`).
                | loading...
