include ../../components/shared/message

+message("Welcome", "is-success")
    .title=`Hello, ${user.name}!`
    p(x-data="{}"
        x-init="new WorHou().incrementVisits()")
        span(x-text="new WorHou().visits > 1 ? 'Welcome Back!' : 'Are you new here?'") ...
    p
        a(href=`${base}/timelog`) Check out your timelog
