include ../../components/shared/message
include ../../components/timelog/clock-stamp

+message(`Timelogs for ${day}`, "is-info today-stamps")
    each s in stamps
        +clock-stamp(s, format(s.stamp, 'HH:mm'))
    if !stamps || stamps.length == 0
      i.is-text.is-warning nothing clocked today
    .field.is-grouped.p-4
        button.button(
            hx-swap="outerHTML"
            hx-target="closest .today-stamps"
            hx-post=`${base}/timelog/clock-in`
            hx-confirm="Are you sure? a stamp can never be deleted")
            | Clock-in now
