include ../../components/shared/key-val

each day,i in Object.keys(sheet)
    details.line-sheet(class={'line-sheet-odd': i % 2 !== 0})
        summary.is-flex
            +key-val(day,
              `${sheet[day].total.hours}h ${sheet[day].total.minutes}m ${sheet[day].total.seconds}s`,
              {'class': 'is-flex-grow-1'})
        .fixed-grid.has-4-cols.is-gap-2.m-2
            .grid
              each turn in sheet[day].periods
                  .cell(style={'white-space': 'nowrap'})=`${format(turn.start.stamp, 'HH:mm')} - ${format(turn.end.stamp, 'HH:mm')}`
              else
                  .cell.is-col-span-4.is-flex.is-justify-content-center
                      i No time clocked this day
