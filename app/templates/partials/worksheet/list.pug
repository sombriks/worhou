include ../../components/shared/key-val
.sheet
    form.is-flex.is-justify-content-space-between.m-2.is-gap-2(
        hx-get=`${base}/worksheet/list`
        hx-target="closest .sheet"
        hx-swap="outerHTML"
        hx-trigger="change")
        .peeiod.radios
            label.radio(title="Last month")
                input(type="radio"
                    name="period"
                    value="lastMonth"
                    checked=period === 'lastMonth' || period === undefined)/
                i.mdi.mdi-calendar-month
            label.radio(title="Last week")
                input(type="radio"
                    name="period"
                    value="lastWeek"
                    checked=period === 'lastWeek')/
                i.mdi.mdi-calendar-week
        .sorting.radios
            label.radio(title="Sort ascending")
                input(type='radio'
                    name='sorting'
                    value='asc'
                    checked=sorting !== 'dec')/
                i.mdi.mdi-arrow-up-bold
            label.radio(title="Sort descending")
                input(type='radio'
                    name='sorting'
                    value='dec'
                    checked=sorting === 'dec')/
                i.mdi.mdi-arrow-down-bold
  -
      let days = Object.keys(sheet)
      if (sorting === 'dec') days = days.reverse()
  each day,i in days
      details.line-sheet(class={'line-sheet-odd': i % 2 !== 0})
          summary.is-flex
              +key-val(day,
                `${sheet[day].total.hours}h ${sheet[day].total.minutes}m ${sheet[day].total.seconds}s`,
                {'class': 'is-flex-grow-1'})
          .fixed-grid.has-4-cols.is-gap-2.m-2
              .grid
                each turn in sheet[day].periods
                    .cell(style={'white-space': 'nowrap'})=`${format(turn.start.stamp, 'HH:mm')} - ${format(turn.end.stamp, 'HH:mm')}`
                else
                    .cell.is-col-span-4.is-flex.is-justify-content-center
                        i No time clocked this day
