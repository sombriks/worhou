mixin clock-stamp(stamp, hour)
    .is-flex.is-justify-items-center.is-align-items-center.m-2.is-gap-1
        div.is-flex-grow-1(class={'is-italic': !!stamp.replaced_id})=hour
        button.button(title="Details"
            hx-target="body"
            hx-swap="append"
            hx-get=`${base}/timelog/${stamp.id}`)
            span.icon
                i.mdi.mdi-eye
        button.button(title="Correction"
            hx-target="body"
            hx-swap="append"
            hx-get=`${base}/timelog/${stamp.id}?edit=true`)
            span.icon
                i.mdi.mdi-pencil
