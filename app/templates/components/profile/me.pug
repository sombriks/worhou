include ../shared/message

mixin me()
    +message("Profile")
        p Login details
        .field.is-grouped.is-grouped-right
            button.button.is-warning Log out
            script(type="text/javascript").
                lobRoot(e => {
                  e.querySelector('button').addEventListener('click', () => {
                    new WorHou().logout();
                    window.location.reload();
                  });
                });

