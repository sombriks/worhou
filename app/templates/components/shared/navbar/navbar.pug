// navbar
include ./navbar-item

mixin navbar()
    nav.navbar(
        x-data="{ open: false }"
        role="navigation"
        aria-label="main navigation"
    )
        .navbar-brand
            a.navbar-item.font-weight-bold(
                href=`${base}/`
                :class=`{ 'is-active': window.location.pathname === '${base}/' }`
            )
                span.mdi.mdi-clock-outline(style="font-size:2rem;")

            a.navbar-burger(
                role="button"
                aria-label="menu"
                :aria-expanded="open.toString()"
                :class="{ 'is-active': open }"
                @click="open = !open"
            )
                span(aria-hidden="true")
                span(aria-hidden="true")
                span(aria-hidden="true")
                span(aria-hidden="true")

        .navbar-menu(:class="{ 'is-active': open }")
            .navbar-start
                +navbar-item("Timelog", `${base}/timelog`, "mdi mdi-clock-outline")
                +navbar-item("Worksheet", `${base}/worksheet`, "mdi mdi-text-box-check-outline")
            .navbar-end
                +navbar-item("Teams", `${base}/teams`, "mdi mdi-account-group-outline")
                +navbar-item("Profile", `${base}/profile`, "mdi mdi-account-circle")
