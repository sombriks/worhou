mixin message(title='', cls='', closable=false)
    .message.is-inline-block.p-3(x-data="{}" class=cls)
        .message-header
            p=title
            if closable
                button.delete(
                    aria-label="close"
                    @click="$el.closest('.message').remove()")
        .message-body
            if block
                block
