{
  "type": "module",
  "name": "worhou",
  "version": "1.0.0",
  "description": "Working hours sample app",
  "keywords": [
    "knex",
    "fastify",
    "pug",
    "htmx",
    "bulma"
  ],
  "author": "sombriks",
  "license": "MIT",
  "main": "app/main.js",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#configs/*": "./app/configs/*",
    "#controllers/*": "./app/controllers/*",
    "#models/*": "./app/models/*",
    "#services/*": "./app/services/*"
  },
  "scripts": {
    "db:up": "docker compose -f app/infra/database.yml up",
    "db:down": "docker compose -f app/infra/database.yml down",
    "dev": "node --env-file=.env --watch app/main.js",
    "test": "c8 ava",
    "lint": "xo --fix",
    "migrate:make": "knex --knexfile app/migrations/knexfile.js migrate:make --",
    "migrate:latest": "knex --knexfile app/migrations/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile app/migrations/knexfile.js migrate:rollback --all",
    "migrate:up": "knex --knexfile app/migrations/knexfile.js migrate:up",
    "migrate:down": "knex --knexfile app/migrations/knexfile.js migrate:down"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/knex": "^0.15.2",
    "@types/node": "^26.4.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "js-yaml": "^5.4.1",
    "xo": "^4.0.0"
  },
  "dependencies": {
    "@date-fns/cdn": "^4.4.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@fastify/websocket": "^11.3.0",
    "@mdi/font": "^7.4.47",
    "alpinejs": "^3.17.0",
    "bulma": "^1.0.4",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.1",
    "htmx.org": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pug": "^3.0.4"
  },
  "c8": {
    "reports-dir": ".coverage"
  },
  "ava": {
    "timeout": "3m",
    "files": [
      "app/**/*.spec.js",
      "app/*.spec.js"
    ]
  }
}
